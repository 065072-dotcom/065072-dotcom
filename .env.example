# --- Local dev only (Vite exposes VITE_ vars to the browser) ---
# Copy to .env for `npm run dev`. Never commit .env.
# Get a key at https://console.groq.com/keys
VITE_GROQ_API_KEY=your_groq_api_key_here

# --- Production (Vercel server proxy) ---
# Set this in Vercel Dashboard → Project → Settings → Environment Variables.
# Do NOT prefix with VITE_. The browser never sees it; /api/summarize uses it.
# GROQ_API_KEY=gsk_...
# Optional model override (default: openai/gpt-oss-120b). Server-side:
# GROQ_MODEL=openai/gpt-oss-120b
# Local dev direct-mode override:
# VITE_GROQ_MODEL=openai/gpt-oss-120b
